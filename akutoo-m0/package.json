{
  "name": "akutoo-camera-m0",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "assets": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/verify-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173 --strictPort",
