    "test:e2e:deployed": "node scripts/test-deployed.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.7.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.0.3",
    "vitest": "4.1.11"
  }
}
